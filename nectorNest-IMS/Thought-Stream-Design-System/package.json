{
  "name": "@thoughtstream/ui",
  "version": "0.1.0",
  "description": "Contemplative, minimalist, distraction-free React design system and component library.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-dts": "^4.5.0",
    "@storybook/addon-docs": "^10.6.1"
  },
  "keywords": [
    "react",
    "design-system",
    "storybook",
    "thoughtstream",
    "minimalist",
    "zen",
    "component-library",
    "typescript"
  ],
  "author": "ThoughtStream",
  "license": "MIT"
}
