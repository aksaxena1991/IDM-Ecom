NODE_ENV=development
PORT=8100
LOG_LEVEL=info

# PostgreSQL (pgvector) — default matches docker-compose in this folder
DATABASE_URL=postgresql://chatbot:chatbot_dev_password@localhost:5434/chatbot

# Shared with SSO-BE for optional token revocation checks
REDIS_URL=redis://localhost:6379/1

# SarwaAmrit SSO (OIDC issuer + JWKS)
SSO_ISSUER=http://localhost:8000
SSO_JWKS_URI=http://localhost:8000/.well-known/jwks.json

# Comma-separated or JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3003

# Admin API: comma-separated SSO permission strings (any match grants admin routes)
CHAT_ADMIN_PERMISSIONS=admin:*,platform-super-admin:access

# Rate limit (requests per minute per subject)
CHAT_RATE_LIMIT_PER_MINUTE=60
