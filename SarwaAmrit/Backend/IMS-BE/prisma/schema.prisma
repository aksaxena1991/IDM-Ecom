generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VendorListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(120)
  slug        String         @unique @db.VarChar(140)
  description String         @default("")
  status      CategoryStatus @default(DRAFT)
  parentId    String?        @map("parent_id") @db.Uuid
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  @@map("categories")
}

model Product {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String        @db.VarChar(250)
  slug             String        @unique @db.VarChar(280)
  shortDescription String?       @db.VarChar(500)
  description      String?       @db.Text

  categoryId String  @db.Uuid
  brandId    String? @db.Uuid

  status     ProductStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  variants ProductVariant[]
  media    ProductMedia[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([status, createdAt])
  @@index([isFeatured, status])
  @@index([deletedAt])
}

model ProductVariant {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String               @db.Uuid
  sku       String               @unique @db.VarChar(100)
  name      String               @db.VarChar(200)
  barcode   String?              @unique @db.VarChar(100)

  attributes Json?

  weightGrams Int?
  status      ProductVariantStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  listings VendorListing[]
  media    ProductMedia[]

  @@index([productId, status])
}

model ProductMedia {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String           @db.Uuid
  variantId String?          @db.Uuid
  type      ProductMediaType @default(IMAGE)
  url       String           @db.VarChar(2048)
  altText   String?          @db.VarChar(300)
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(150)
  slug      String   @unique @db.VarChar(180)
  logoUrl   String?  @db.VarChar(2048)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  products Product[]
}

model Vendor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(80)
  email     String?  @unique @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  listings VendorListing[]
}

model VendorListing {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String @db.Uuid
  variantId String @db.Uuid

  price    Decimal @db.Decimal(12, 2)
  mrp      Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  stockQuantity Int                 @default(0)
  status        VendorListingStatus @default(DRAFT)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  vendor  Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([vendorId, variantId])
  @@index([variantId, status, price])
  @@index([vendorId, status])
}
