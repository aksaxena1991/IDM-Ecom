VITE_OIDC_CLIENT_ID=ai-chat-oidc-app
VITE_OIDC_SCOPE=openid profile email groups
VITE_DEFAULT_TENANT_SLUG=demo
VITE_CHAT_APPLICATION_ID=idm
VITE_CHAT_APPLICATION_LABEL=Sarwa Amrit Assistant

# Local dev uses Vite proxy paths (/sso, /chat-api) automatically.
# For production builds, set absolute URLs:
# VITE_SSO_BASE_URL=https://sso.example.com
# VITE_CHAT_API_BASE_URL=https://chat-api.example.com
# VITE_OIDC_REDIRECT_URI=https://chat.example.com/callback
