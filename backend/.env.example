APP_NAME=SSO Backend
ENVIRONMENT=local
DEBUG=true
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://sso:sso_dev_password@localhost:5432/sso
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_NAME=sso_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
ID_TOKEN_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CODE_TTL_SECONDS=60
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_RATE_LIMIT_PER_MINUTE=100
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
MFA_ENCRYPTION_KEY=change-me-32-byte-base64-or-passphrase
SIGNING_KEYS_DIR=./keys